<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lucy_config_generator</name>
  <version>0.0.0</version>
  <description>Generate RP2040 firmware C, ros2_control xacro, and controllers.yaml from hardware YAML (#96).</description>
  <maintainer email="contact@lucy-robotics.com">Lucy Robotics Team</maintainer>
  <license>GPL-3.0</license>

  <exec_depend>python3-jinja2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
