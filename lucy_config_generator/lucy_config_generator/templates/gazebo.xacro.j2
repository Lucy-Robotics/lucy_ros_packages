<?xml version="1.0"?>
<!-- Generated by lucy_config_generator — do not edit. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="{{ robot_name }}" version="1.0">

{% for block in blocks %}
  <ros2_control name="{{ block.hardware_name }}" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
{% for j in block.joints %}
    <joint name="{{ j.urdf_joint }}">
      <param name="virtual_pin">{{ j.virtual_pin }}</param>
      <param name="servo_type">{{ j.servo_type | replace('"', '') }}</param>
      <param name="offset_rad">{{ j.offset_rad }}</param>
      <param name="direction">{{ j.direction }}</param>
      <param name="scale">{{ j.scale }}</param>
      <param name="servo_min_rad">{{ j.servo_min_rad }}</param>
      <param name="servo_max_rad">{{ j.servo_max_rad }}</param>
      <param name="servo_default_rad">{{ j.servo_default_rad }}</param>
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
{% endfor %}
  </ros2_control>
{% endfor %}

{% for sensor in sensors %}
  <gazebo>
    <plugin filename="mock_sensor" name="mock_sensor::MockSensorSystem">
      <update_rate>10</update_rate>
      <topic_name>{{ sensor.topic }}</topic_name>
{% for s in sensor.sensors %}
        <sensor/>
{% endfor %}
    </plugin>
  </gazebo>
{% endfor %}

{% for camera in cameras %}
  <gazebo reference="{{ camera.link }}">
    <sensor type="camera" name="{{ camera.name }}">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <!-- gz publishes raw frames here; gazebo.launch.py republishes raw->compressed onto {{ camera.topic }} for the LCP. -->
      <topic>{{ camera.topic }}</topic>
      <camera name="camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
{% endfor %}

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_config)</parameters>
      <!-- Empty namespace so controller topics stay at /left_arm_controller, /right_arm_controller (panel expects these). -->
      <namespace></namespace>
    </plugin>
  </gazebo>
</robot>
