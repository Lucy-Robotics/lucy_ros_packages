# Request
string command                # start, capture_mid, begin_joint, accept_joint, apply, cancel,
                              # resume, restore, verify_drive, back_to_review, finish,
                              # select_adapter, adopt
string argument               # joint name, preset name, adapter serial, or "override"
---
# Response
bool success
string error                  # stable code for the panel, empty on success
string message                # for the user
string status_json            # session state right after the command
