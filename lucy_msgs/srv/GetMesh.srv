# Request
string path                   # mesh reference from the URDF (file://, package://, or absolute)
string quality                # full, balanced or light: the GLB beside the mesh when committed; empty: the source file
---
# Response
bool success
string message
# Payload encoding for `data`:
#   utf8         — text mesh (Collada/DAE XML)
#   zlib_base64  — zlib-compressed binary (STL), then standard base64
#   glb_base64   : meshopt GLB at the requested quality, then standard base64
string encoding
string data
