<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lucy_config_pipeline</name>
  <version>0.0.0</version>
  <description>Config store services and ConfigurePipeline action server for Lucy hardware YAML pipeline.</description>
  <maintainer email="contact@lucy-robotics.com">Lucy Robotics Team</maintainer>
  <license>GPL-3.0</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>lucy_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>
  <depend>xacro</depend>

  <exec_depend>lucy_config_generator</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
